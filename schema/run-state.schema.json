{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schema/run-state.schema.json",
  "title": "Agent Runs Run State",
  "type": "object",
  "required": ["schema_version", "run_id", "agent", "status", "phase", "started_at", "last_activity_at", "progress", "blockers", "artifacts", "verification"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "run_id": {"type": "string", "minLength": 1},
    "agent": {"type": "string", "minLength": 1},
    "status": {"enum": ["pending", "in_progress", "blocked", "verification_pending", "completed", "cancelled"]},
    "phase": {"type": "string"},
    "started_at": {"type": "string", "format": "date-time"},
    "last_activity_at": {"type": "string", "format": "date-time"},
    "branch": {"type": ["string", "null"]},
    "progress": {
      "type": "object",
      "required": ["completed", "current", "next"],
      "properties": {
        "completed": {"type": "array", "items": {"type": "string"}},
        "current": {"type": ["string", "null"]},
        "next": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "blockers": {"type": "array", "items": {"type": "object"}},
    "artifacts": {"type": "object", "additionalProperties": true},
    "verification": {"type": "object", "additionalProperties": true},
    "completed_at": {"type": ["string", "null"], "format": "date-time"}
  },
  "additionalProperties": true
}
